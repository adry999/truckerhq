# Optional. Without it, Carrier Lookup search falls back to sample data.
#
# Get a free webKey:
# 1. https://mobile.fmcsa.dot.gov/QCDevsite/docs/getStarted -> sign in with login.gov
# 2. "My WebKeys" -> "Get a new WebKey"
# 3. Paste it below.
FMCSA_WEBKEY=

# Required for forms (dispatch/start, apply, hire drivers, contact, compliance
# alerts) to save leads. Project: https://supabase.com/dashboard/project/wjpdghtxhmqnvbpobtjn
# Settings -> API for the URL and the anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Without these, Analytics renders nothing (no scripts loaded).
# GA4: Admin -> Data Streams -> your web stream -> Measurement ID (G-XXXXXXX).
# Meta Pixel: Events Manager -> your pixel -> Settings -> Pixel ID (numeric).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Without it, confirmation SMS (dispatch/apply/compliance alerts)
# are skipped (logged, not sent) and the form still succeeds.
# Console -> Account Info for SID/token; buy/verify a sending number for FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional, not wired to any form yet (none currently collect an email
# address). Install via `vercel integration add resend/resend-email` or
# https://resend.com -> API Keys. RESEND_FROM defaults to a placeholder
# sender until a domain is verified.
RESEND_API_KEY=
RESEND_FROM=

# Comma-separated inbox(es) that get an email for every new lead (needs
# RESEND_API_KEY). Without it, leads only land in Supabase.
LEADS_NOTIFY_TO=

# Canonical public URL, no trailing slash. Drives canonicals, sitemap,
# JSON-LD and the form origin allowlist. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://truckerhq.us
# "true" only on production. Anything else sends noindex everywhere.
NEXT_PUBLIC_INDEXABLE=
# Extra origins allowed to POST to /api/* (comma-separated), e.g. a
# Hostinger temporary domain used for staging.
ALLOWED_ORIGINS=
# Shared secret that a Cloudflare Transform Rule adds as the
# `x-origin-secret` request header. When set, /api/* rejects requests that
# didn't come through Cloudflare (so CF-Connecting-IP can be trusted).
CF_ORIGIN_SECRET=

# Server-only Supabase key (Settings -> API Keys -> secret, sb_secret_...).
# Inserts use it instead of SUPABASE_ANON_KEY so RLS can deny anon entirely.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (Dashboard -> Turnstile -> add widget for the domain).
# Without both, forms work without a CAPTCHA (dev / staging only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
